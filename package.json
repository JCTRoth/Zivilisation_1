{
  "name": "civ1browser",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Civilization 1 clone — headless engine in packages/shared, authoritative server in packages/server, React client in packages/web",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx packages/server/src/main.ts",
    "start:server": "npm run dev:server",
    "build": "vite build",
    "preview": "vite preview",
    "tiles:install": "node tools/tile-generator/install_generated_assets.mjs",
    "test:generator": "python3 tools/tile-generator/abstract_generator.py --selftest",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "knip": "knip",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:secrets": "node scripts/check-no-secrets.mjs",
    "test:k3s": "playwright test --config playwright.k3s.config.ts"
  },
  "dependencies": {
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.11.2",
    "canvas-confetti": "^1.9.4",
    "react": "^18.3.1",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^18.3.1",
    "tsx": "^4.23.15",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20.5.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.18.2",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "knip": "^6.24.0",
    "typescript": "^5.6.0",
    "vite": "^7.2.7",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
