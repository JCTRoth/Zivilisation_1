# Copy to .env for local docker compose. Never commit the real .env.
POSTGRES_DB=civ1
POSTGRES_USER=civ1
POSTGRES_PASSWORD=replace-with-a-local-dev-password
GAME_SERVER_SECRET=replace-with-a-local-dev-secret
# Compose uses the hostname `postgres:5432` inside its network.
# `npm run dev:local` rewrites this to localhost:5433 for the host server.
PG_URL=postgres://civ1:replace-with-a-local-dev-password@postgres:5432/civ1
