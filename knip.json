{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "packages/shared": {
      "entry": ["index.ts", "game/engine/GameEngine.ts"]
    },
    "packages/web": {
      "entry": ["index.html", "src/Main.tsx", "src/App.tsx"]
    },
    "packages/server": {
      "entry": ["src/index.ts"]
    }
  },
  "entry": ["tests/**/*.test.ts", "e2e/**/*.spec.ts", "e2e/**/*.ts", "scripts/**/*.mjs"],
  "project": ["packages/**/*.{ts,tsx}", "tests/**/*.ts", "e2e/**/*.ts"],
  "ignoreBinaries": ["magick"]
}
